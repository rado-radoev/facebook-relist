# Relist environment — copy this file to `.env` (same folder) and edit.
#
# The two Docker Compose values below are the ones a home deployment
# actually needs. The frontend override at the bottom is for local
# development only — Docker does not use it.

# --- Docker Compose ---------------------------------------------------

# The exact address you will open on your phone, including the port.
# The backend only accepts sign-ins from this origin (plus any address on
# the machine itself), so it must match what you type in the phone's
# browser EXACTLY — replace 192.168.1.20 with your Docker host's LAN IP.
CORS_ORIGIN=http://192.168.1.20:5173

# Safety switch for recreate jobs. Leave unset (or 1) for dry-run:
# nothing is posted or deleted on Facebook. Set to 0 ONLY for a
# supervised live run, one listing, watched end to end.
# RELIST_DRY_RUN=0

# OPTIONAL — "Sign in to Relist with Facebook": lets you sign in to the
# app itself with Facebook instead of a separate Relist password. Create
# a Meta app (Facebook Login use case) at developers.facebook.com, set
# its Valid OAuth Redirect URI to
# https://fbrelist.superlan.duckdns.org/api/auth/facebook/callback
# (your public Relist address + that path), then put the app id and app
# secret here. The secret goes ONLY in this .env on the Docker host —
# never in chat, never in git. Leave both unset and the feature stays
# off. See the README section "Sign in to Relist with Facebook".
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=

# --- Frontend build override (local development only) -----------------

# Base URL of the Relist backend API (see server/.env.example).
# Normally unset: the app already talks to the backend on the same host
# the page was served from, port 8787. Set it only to point the frontend
# somewhere unusual.
# VITE_API_BASE_URL=http://localhost:8787
