# Relist backend configuration. Copy to .env and adjust; every value has a
# sane local default, so an empty .env works for local development.

# Port the API listens on.
PORT=8787

# Interface to bind. 0.0.0.0 makes the backend reachable from the phone on
# the home network; 127.0.0.1 keeps it on this machine only.
HOST=0.0.0.0

# Where Relist keeps its data: user accounts (hashed passwords), app
# sessions, and one persistent browser profile per user under
# <DATA_DIR>/profiles/<userId>/. Relative paths resolve from server/.
DATA_DIR=./data

# Frontend origin allowed to call the API with credentials (CORS).
CORS_ORIGIN=http://localhost:5173

# Set to 1 when serving over HTTPS so the session cookie gets the Secure
# flag. Leave unset for plain-HTTP local development.
# COOKIE_SECURE=1

# Optional proxy for the backend browser, e.g.
# BROWSER_PROXY=http://user:pass@proxy-host:3128 — when unset, the
# standard HTTPS_PROXY env is used if present; with neither, the browser
# connects directly (the normal case on the home server).
# BROWSER_PROXY=

# SANDBOX ONLY: set to 1 to make the backend browser ignore TLS
# certificate errors. Needed in sandboxes whose egress proxy intercepts
# TLS with a local CA. NEVER enable this on the home server.
# BROWSER_IGNORE_CERT_ERRORS=1
