# Relist backend configuration. Copy to .env and adjust; every value has a
# sane local default, so an empty .env works for local development.

# Port the API listens on.
PORT=8787

# Interface to bind. The default (leave unset) is "::" — dual-stack, so
# the backend answers on both 127.0.0.1 and ::1 and stays reachable from
# the phone on the home network. Setting HOST overrides it: 0.0.0.0 is
# IPv4-only (some browsers resolve "localhost" to ::1 first and then
# can't reach an IPv4-only bind); 127.0.0.1 keeps it on this machine.
# HOST=::

# Where Relist keeps its data: user accounts (hashed passwords), app
# sessions, and one persistent browser profile per user under
# <DATA_DIR>/profiles/<userId>/. Relative paths resolve from server/.
DATA_DIR=./data

# Frontend origin allowed to call the API with credentials (CORS).
# Any loopback origin (localhost / 127.0.0.1 / [::1], any port) is also
# always accepted, so local runs work under every spelling; this setting
# matters for non-loopback origins, e.g. a Tailscale/LAN frontend host.
CORS_ORIGIN=http://localhost:5173

# Set to 1 when serving over HTTPS so the session cookie gets the Secure
# flag. Leave unset for plain-HTTP local development.
# COOKIE_SECURE=1

# Optional proxy for the backend browser, e.g.
# BROWSER_PROXY=http://user:pass@proxy-host:3128 — when unset, the
# standard HTTPS_PROXY env is used if present; with neither, the browser
# connects directly (the normal case on the home server).
# BROWSER_PROXY=

# SANDBOX ONLY: set to 1 to make the backend browser ignore TLS
# certificate errors. Needed in sandboxes whose egress proxy intercepts
# TLS with a local CA. NEVER enable this on the home server.
# BROWSER_IGNORE_CERT_ERRORS=1

# Sprint 3 SAFETY SWITCH — recreate-job dry-run. DEFAULT IS ON (unset
# means ON): a dry-run job walks every step against the browser but
# stops before posting the new listing and before confirming the old
# listing's delete, so it can never change anything on Facebook.
# Set to 0 ONLY when real recreates are wanted (Sprint 4, owner
# present, one listing, watched end to end).
# RELIST_DRY_RUN=0

# How often a recreate job re-checks a new listing that is in review
# (milliseconds; default 900000 = about every 15 minutes, jittered).
# RELIST_POLL_INTERVAL_MS=900000

# How long review may last before a job is marked stuck and stops
# without deleting the old listing (milliseconds; default = 48 hours).
# RELIST_STUCK_AFTER_MS=172800000
